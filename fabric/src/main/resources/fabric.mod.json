{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "A Christmas adventure: Santa's workshop, Krampus's lair and goblin camps in the snow, and presents that hold gifts or coal depending on your karma.",
  "icon": "assets/cozychristmas/icon.png",
  "authors": [
    "eliasnvx"
  ],
  "contact": {
    "homepage": "https://cubimoon.com"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.eliasnvx.cozychristmas.fabric.CozyChristmasFabric"
    ],
    "client": [
      "dev.eliasnvx.cozychristmas.fabric.CozyChristmasFabricClient"
    ],
    "jade": [
      "dev.eliasnvx.cozychristmas.compat.jade.CozyJadePlugin"
    ],
    "jei_mod_plugin": [
      "dev.eliasnvx.cozychristmas.compat.jei.CozyJeiPlugin"
    ],
    "rei_client": [
      "dev.eliasnvx.cozychristmas.compat.rei.CozyReiPlugin"
    ]
  },
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_api_version}",
    "geckolib": ">=${geckolib_version}",
    "java": ">=17"
  },
  "suggests": {
    "jade": "*",
    "jei": "*",
    "roughlyenoughitems": "*",
    "sereneseasons": "*"
  },
  "mixins": [
    "cozychristmas.mixins.json"
  ]
}
